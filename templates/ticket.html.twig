{% import 'components/form/fields_macros.html.twig' as fields %}

{% if canedit %}
    <form name="form"
          action="{{ form_path }}"
          method="post"
          data-track-changes="true">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
{% endif %}

<div class="row">
    {{ fields.smallTitle(__('Send ticket information by mail', 'ticketmail')) }}
    {{ fields.hiddenField('ticket_id', item.fields['id'], '') }}
    {{ fields.dropdownArrayField('ticket_mail_type', 'glpi', {
        'glpi': __('GLPI user', 'ticketmail'),
        'custom': __('Custom email')
    }, __('Recipient', 'ticketmail'), {
        'on_change': 'recipientChooser(this)'
    }) }}
    {% set userDropdown = call('User::dropdown', [{
        'right': 'all',
        'comments': false,
        'display': false,
        'required': false,
        'value': null,
        'placeholder': __('Select user', 'ticketmail'),
        'display_emptychoice': true,
    }]) %}
    {{ fields.field('users_id', userDropdown, __('To', 'ticketmail'), {
        'add_field_attribs': {
            'id': 'ticket_mail_users_id'
        },
        'full_width': true,
        'required': false,
    }) }}
    {{ fields.emailField('ticket_mail_custom_mail', '', __('To', 'ticketmail'), {
        'add_field_attribs': {
            'id': 'ticket_mail_custom_mail',
            'style': 'display: none;',
        },
        'full_width': true,
    }) }}
    {{ fields.textareaField('ticket_mail_note', '', __('Note', 'ticketmail'), {
        'full_width': true,
        'enable_richtext': true,
    }) }}
</div>

<script type="text/javascript">
    function recipientChooser(element) {
        if ($(element).val() === 'custom') {
            $('#ticket_mail_users_id').hide();
            $('#ticket_mail_users_id').find('select').val('').trigger('change')
            $('#ticket_mail_custom_mail').show();
        } else if ($(element).val() === 'glpi') {
            $('#ticket_mail_users_id').show();
            $('#ticket_mail_custom_mail').hide();
            $('#ticket_mail_custom_mail').find('input').val('')
        }
    }
</script>

{% if canedit %}
        <div class="card-footer mx-n2 d-flex">
            <button type="submit" name="update" value="1" class="ms-auto btn btn-primary">
                <i class="ti ti-send"></i>
                <span>{{ __('Send', 'ticketmail') }}</span>
            </button>
        </div>
    </form>
{% endif %}
